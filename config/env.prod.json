{
   "testDir": "./tests",
   "fullyParallel": true,
   "retries": 2,
   "timeout": 30000,
  "use":
  {
    "headless": true,
    "baseUrl": "https://demowebshop.tricentis.com/",       
    "trace": "on-first-retry",
    "screenshot": "only-on-failure",
    "video": "retain-on-failure"
  },  
  "reporter":
  {
    "reportType": "html",
    "dynamicReporter": "./reporting/CustomReporter.ts",
    "logDir": "test-logs"
  },
  "projects":
  {
    "use": {
      "devices": "Desktop Chrome",
      "channel": "chrome",
      "viewport": null
    }
  } 
}